[Unit]
Description=Desktop Layer - Clickable desktop surface for right-click menu and window unfocus
Documentation=file:///usr/share/doc/desktop-layer/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Slice=session-graphical.slice
WorkingDirectory=%h/Systems/desktop/desktop-layer
Environment=PYTHONPATH=%h/Systems/desktop/desktop-layer/src
ExecStart=/usr/bin/python3 -m desktop_layer.desktop_layer
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
